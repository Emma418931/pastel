
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Pastel.io</title>
<style>
:root {
  --pink:#f5a9cb;
  --purple:#c5b2f5;
  --blue:#a9d8f5;
  --mint:#a9e5d0;
  --yellow:#f5dfa0;
  --ink:#49465b;
  --bg:#f8f7fc;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:system-ui,-apple-system,sans-serif;
  overflow:hidden;touch-action:none;
}
button{font:inherit;cursor:pointer;border:0}
#app{height:100dvh;display:flex;flex-direction:column}
header{
  height:64px;display:flex;align-items:center;justify-content:space-between;
  padding:0 18px;background:#fff;box-shadow:0 3px 15px #5551;z-index:2;
}
.logo{font-size:23px;font-weight:900;letter-spacing:-1px;color:#d77fac}
.logo span{color:#9b8cda}
.header-actions{display:flex;gap:8px}
.small-btn{
  background:#f3effa;border-radius:13px;padding:9px 13px;
  color:var(--ink);font-weight:700;
}
main{flex:1;position:relative;min-height:0;display:flex;flex-direction:column}
#hud{
  display:flex;align-items:center;justify-content:space-between;
  gap:10px;padding:10px 15px;background:#fff;
}
.stat{font-size:12px;color:#89869a;font-weight:700}
.stat strong{display:block;font-size:17px;color:var(--ink)}
.progress{height:7px;background:#eeeaf5;border-radius:10px;overflow:hidden;margin-top:4px}
#progressFill{height:100%;width:0;background:linear-gradient(90deg,#ee9dc6,#b9a7ed);transition:width .2s}
#boardWrap{flex:1;min-height:0;position:relative;background:#f1f0f8;overflow:hidden}
canvas{width:100%;height:100%;display:block;touch-action:none}
#controls{
  position:absolute;bottom:12px;left:12px;right:12px;
  display:flex;justify-content:space-between;align-items:flex-end;
  pointer-events:none;
}
#joystick{
  width:112px;height:112px;border-radius:50%;
  background:#ffffffa8;border:2px solid #ffffff;
  box-shadow:0 4px 18px #5552;position:relative;
  pointer-events:auto;touch-action:none;
}
#stick{
  position:absolute;width:43px;height:43px;border-radius:50%;
  background:linear-gradient(145deg,#f4b6d3,#c6b5ed);
  box-shadow:0 3px 9px #5553;left:33px;top:33px;
}
#mobileHint{
  align-self:center;background:#ffffffd9;border-radius:15px;
  padding:9px 13px;font-size:11px;color:#858096;
}
#overlay{
  position:absolute;inset:0;display:flex;align-items:center;
  justify-content:center;background:#f8f7fceF;z-index:5;
  padding:18px;overflow:auto;
}
.panel{
  width:min(440px,100%);max-height:95%;overflow:auto;
  background:#fff;border-radius:27px;padding:25px;
  box-shadow:0 12px 45px #61577b20;text-align:center;
}
h1{font-size:37px;letter-spacing:-2px;margin:0 0 5px;color:#d77fac}
h2{margin:5px 0 12px;font-size:24px}
.subtitle{color:#9994a7;font-size:13px;margin-bottom:20px}
.emoji-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin:18px 0}
.emoji-choice{
  border:2px solid transparent;background:#f8f6fb;border-radius:16px;
  padding:11px 3px;font-size:27px;transition:.15s;
}
.emoji-choice.selected{border-color:#e7a1c7;background:#fff0f7;transform:scale(1.05)}
.primary{
  width:100%;padding:14px;border-radius:16px;
  background:linear-gradient(110deg,#eda4c8,#b9a9ed);
  color:white;font-weight:800;font-size:15px;margin-top:9px;
  box-shadow:0 5px 14px #d3a3d033;
}
.secondary{background:#f2eff8;color:#69637c}
.levels{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:17px 0}
.level{
  padding:13px 3px;border-radius:13px;background:#f3f0f8;
  color:#625c77;font-weight:800;
}
.level.locked{opacity:.35}
.level.active{background:#fce6f1;color:#ca6d9e}
.level small{display:block;font-size:10px;margin-top:3px}
.info{font-size:12px;color:#9994a7;line-height:1.6;margin:12px 0}
.hidden{display:none!important}
#toast{
  position:absolute;top:55px;left:50%;transform:translateX(-50%);
  background:#fff;padding:9px 16px;border-radius:14px;
  box-shadow:0 3px 15px #5552;font-size:12px;z-index:3;
  white-space:nowrap;pointer-events:none;
}
@media(min-width:800px){
  #boardWrap{margin:0 auto;width:min(100%,1100px)}
  #controls{max-width:1100px;left:50%;right:auto;width:100%;transform:translateX(-50%)}
}
</style>
</head>
<body>
<div id="app">
<header>
  <div class="logo">pastel<span>.io</span> ✦</div>
  <div class="header-actions">
    <button class="small-btn" id="restartBtn">↻</button>
    <button class="small-btn" id="pauseBtn">Ⅱ</button>
    <button class="small-btn" id="menuBtn">☰</button>
  </div>
</header>
<main>
  <div id="hud">
    <div class="stat">MEIN GEBIET<strong id="percent">0%</strong>
      <div class="progress" style="width:110px"><div id="progressFill"></div></div>
    </div>
    <div class="stat" style="text-align:center">LEVEL<strong id="levelText">1</strong></div>
    <div class="stat" style="text-align:right">GEGNER<strong id="enemies">5</strong></div>
    <div class="stat" style="text-align:right">ZIEL<strong id="goal">20%</strong></div>
  </div>
  <div id="boardWrap">
    <canvas id="game"></canvas>
    <div id="toast" class="hidden"></div>
    <div id="controls">
      <div id="joystick"><div id="stick"></div></div>
      <div id="mobileHint">WASD / Pfeiltasten oder Joystick</div>
    </div>
  </div>
  <div id="overlay">
    <div class="panel" id="startPanel">
      <h1>pastel.io ✦</h1>
      <div class="subtitle">Claim your space. Own the board.</div>
      <h2>Wähle deinen Spieler</h2>
      <div class="emoji-grid" id="emojiGrid"></div>
      <div class="info">Erobere Gebiete, schließe deine Spur und passe auf, dass dich niemand erwischt.</div>
      <button class="primary" id="chooseLevelBtn">LEVEL AUSWÄHLEN →</button>
    </div>
    <div class="panel hidden" id="levelPanel">
      <h2>Wähle dein Level</h2>
      <div class="subtitle">Schalte neue Herausforderungen frei.</div>
      <div class="levels" id="levelGrid"></div>
      <div class="info" id="levelDescription"></div>
      <button class="primary" id="startBtn">SPIEL STARTEN →</button>
      <button class="primary secondary" id="backBtn">ZURÜCK</button>
    </div>
    <div class="panel hidden" id="pausePanel">
      <h2>Pause ⏸</h2>
      <div class="subtitle">Dein Spiel ist angehalten.</div>
      <button class="primary" id="resumeBtn">WEITERSPIELEN</button>
      <button class="primary secondary" id="pauseRestartBtn">LEVEL NEUSTARTEN</button>
      <button class="primary secondary" id="pauseMenuBtn">HAUPTMENÜ</button>
    </div>
    <div class="panel hidden" id="endPanel">
      <h1 id="endEmoji">✨</h1>
      <h2 id="endTitle">Level geschafft!</h2>
      <div class="subtitle" id="endText"></div>
      <button class="primary" id="nextBtn">WEITER →</button>
      <button class="primary secondary" id="againBtn">NOCHMAL SPIELEN</button>
      <button class="primary secondary" id="endMenuBtn">LEVELAUSWAHL</button>
    </div>
  </div>
</main>
</div>
<script>
(() => {
"use strict";

const W=64,H=44;
const emojis=["💗","🎀","⭐","🍒","💎","💍","🪷","🫧","🍾","🪩"];
const colors=[
 "#f3a5c9","#c9a9ed","#f1d47e","#eea1aa","#92c9ed",
 "#a9dfcf","#d9a7d9","#a9dce0","#e9bd91","#b7b4ed"
];
const levels=[
 {goal:20,bots:3,speed:135,desc:"Erobere 20 % der Spielfläche. Drei Gegner sind unterwegs."},
 {goal:25,bots:4,speed:120,desc:"Erobere 25 % der Spielfläche. Vier Gegner."},
 {goal:30,bots:5,speed:110,desc:"Erobere 30 % der Spielfläche. Fünf Gegner."},
 {goal:35,bots:6,speed:100,desc:"Erobere 35 % der Spielfläche. Sechs Gegner."},
 {goal:40,bots:7,speed:95,desc:"Erobere 40 % der Spielfläche. Sieben Gegner."},
 {goal:45,bots:7,speed:85,desc:"Erobere 45 % der Spielfläche. Schnellere Gegner."},
 {goal:50,bots:8,speed:80,desc:"Erobere die Hälfte des Spielfeldes."},
 {goal:55,bots:8,speed:75,desc:"Erobere 55 %. Die Gegner werden aggressiver."}
];

const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");
const $=id=>document.getElementById(id);
let selected=0,level=0,unlocked=1,game=null,paused=false;
let lastTime=0,accumulator=0,cell=12,offsetX=0,offsetY=0;
let direction={x:1,y:0},nextDirection={x:1,y:0};
let touchActive=false,touchOrigin=null;
let toastTimer=null;

function showPanel(id){
 ["startPanel","levelPanel","pausePanel","endPanel"].forEach(x=>$(x).classList.add("hidden"));
 $(id).classList.remove("hidden");
 $("overlay").classList.remove("hidden");
}
function hideOverlay(){$("overlay").classList.add("hidden")}
function makeEmojiGrid(){
 $("emojiGrid").innerHTML="";
 emojis.forEach((e,i)=>{
  const b=document.createElement("button");
  b.className="emoji-choice"+(i===selected?" selected":"");
  b.textContent=e;
  b.onclick=()=>{
   selected=i;
   makeEmojiGrid();
  };
  $("emojiGrid").appendChild(b);
 });
}
function makeLevelGrid(){
 $("levelGrid").innerHTML="";
 levels.forEach((l,i)=>{
  const b=document.createElement("button");
  b.className="level "+(i<unlocked?"":"locked")+(i===level?" active":"");
  b.innerHTML=(i<unlocked?"✦":"🔒")+"<small>"+(i+1)+"</small>";
  b.disabled=i>=unlocked;
  b.onclick=()=>{
   level=i;
   makeLevelGrid();
  };
  $("levelGrid").appendChild(b);
 });
 $("levelDescription").textContent=levels[level].desc;
}
$("chooseLevelBtn").onclick=()=>{makeLevelGrid();showPanel("levelPanel")};
$("backBtn").onclick=()=>showPanel("startPanel");
$("startBtn").onclick=()=>startGame();
$("restartBtn").onclick=()=>{if(game)startGame()};
$("menuBtn").onclick=()=>{if(game){paused=true;makeLevelGrid();showPanel("levelPanel")}else showPanel("startPanel")};
$("pauseBtn").onclick=()=>pauseGame();
$("resumeBtn").onclick=()=>{paused=false;hideOverlay()};
$("pauseRestartBtn").onclick=()=>startGame();
$("pauseMenuBtn").onclick=()=>{game=null;makeLevelGrid();showPanel("levelPanel")};
$("againBtn").onclick=()=>startGame();
$("endMenuBtn").onclick=()=>{makeLevelGrid();showPanel("levelPanel")};
$("nextBtn").onclick=()=>{
 if(level+1<levels.length&&level+1<unlocked)level++;
 else if(level+1<levels.length)level++;
 makeLevelGrid();startGame();
};

function pauseGame(){
 if(!game||game.ended)return;
 paused=!paused;
 if(paused)showPanel("pausePanel");else hideOverlay();
}

function resize(){
 const r=$("boardWrap").getBoundingClientRect();
 const dpr=Math.min(devicePixelRatio||1,2);
 canvas.width=Math.round(r.width*dpr);
 canvas.height=Math.round(r.height*dpr);
 ctx.setTransform(dpr,0,0,dpr,0,0);
 cell=Math.min(r.width/W,r.height/H);
 offsetX=(r.width-W*cell)/2;
 offsetY=(r.height-H*cell)/2;
 draw();
}
window.addEventListener("resize",resize);

function newPlayer(id,x,y,emoji,color,isHuman=false){
 const p={
  id,x,y,dir:{x:1,y:0},trail:[],territory:new Set(),
  emoji,color,isHuman,alive:true,steps:0,botTurn:0,
  target:null
 };
 for(let yy=y-3;yy<=y+3;yy++)
  for(let xx=x-3;xx<=x+3;xx++)
   if(xx>=0&&xx<W&&yy>=0&&yy<H)p.territory.add(key(xx,yy));
 return p;
}
const key=(x,y)=>y*W+x;
const unpack=k=>({x:k%W,y:Math.floor(k/W)});

function startGame(){
 const cfg=levels[level];
 game={players:[],ended:false,tick:0};
 paused=false;
 const p=newPlayer(0,Math.floor(W/2),Math.floor(H/2),emojis[selected],colors[selected],true);
 game.players.push(p);
 const used=[selected];
 for(let i=0;i<cfg.bots;i++){
  let index=(selected+i+1)%emojis.length;
  while(used.includes(index))index=(index+1)%emojis.length;
  used.push(index);
  const spots=[
   [8,8],[W-9,8],[8,H-9],[W-9,H-9],
   [Math.floor(W/2),7],[Math.floor(W/2),H-8],
   [12,Math.floor(H/2)],[W-13,Math.floor(H/2)]
  ];
  const s=spots[i%spots.length];
  const bot=newPlayer(i+1,s[0],s[1],emojis[index],colors[index]);
  bot.dir={x:i%2? -1:1,y:0};
  game.players.push(bot);
 }
 direction={x:1,y:0};nextDirection={x:1,y:0};
 accumulator=0;
 $("levelText").textContent=level+1;
 $("goal").textContent=cfg.goal+"%";
 hideOverlay();resize();updateHud();
 lastTime=performance.now();
 requestAnimationFrame(loop);
}

function updateHud(){
 if(!game)return;
 const p=game.players[0];
 const pct=p?Math.floor(p.territory.size/(W*H)*100):0;
 $("percent").textContent=pct+"%";
 $("progressFill").style.width=Math.min(100,pct)+"%";
 $("enemies").textContent=game.players.filter(x=>!x.isHuman&&x.alive).length;
}

function setDirection(x,y){
 if(!game||paused||game.ended)return;
 if(x===-direction.x&&y===-direction.y)return;
 nextDirection={x,y};
}

window.addEventListener("keydown",e=>{
 const map={
  ArrowUp:[0,-1],w:[0,-1],W:[0,-1],
  ArrowDown:[0,1],s:[0,1],S:[0,1],
  ArrowLeft:[-1,0],a:[-1,0],A:[-1,0],
  ArrowRight:[1,0],d:[1,0],D:[1,0]
 };
 if(map[e.key]){
  e.preventDefault();
  setDirection(...map[e.key]);
 }
 if(e.key==="Escape")pauseGame();
});

const joy=$("joystick"),stick=$("stick");
function joyMove(e){
 if(!touchActive)return;
 const r=joy.getBoundingClientRect();
 const dx=e.clientX-(r.left+r.width/2);
 const dy=e.clientY-(r.top+r.height/2);
 const dist=Math.hypot(dx,dy)||1;
 const mx=dx/dist*Math.min(27,dist);
 const my=dy/dist*Math.min(27,dist);
 stick.style.transform=`translate(${mx}px,${my}px)`;
 if(Math.abs(dx)>Math.abs(dy))setDirection(dx>0?1:-1,0);
 else setDirection(0,dy>0?1:-1);
}
joy.addEventListener("pointerdown",e=>{
 touchActive=true;joy.setPointerCapture(e.pointerId);joyMove(e);
});
joy.addEventListener("pointermove",joyMove);
function joyEnd(){
 touchActive=false;stick.style.transform="";
}
joy.addEventListener("pointerup",joyEnd);
joy.addEventListener("pointercancel",joyEnd);

// Swipe control on the playfield
let swipeStart=null;
canvas.addEventListener("pointerdown",e=>{
 if(e.target===joy)return;
 swipeStart={x:e.clientX,y:e.clientY};
});
canvas.addEventListener("pointerup",e=>{
 if(!swipeStart)return;
 const dx=e.clientX-swipeStart.x,dy=e.clientY-swipeStart.y;
 if(Math.hypot(dx,dy)>18){
  if(Math.abs(dx)>Math.abs(dy))setDirection(dx>0?1:-1,0);
  else setDirection(0,dy>0?1:-1);
 }
 swipeStart=null;
});

function isInside(x,y){return x>=0&&x<W&&y>=0&&y<H}
function has(set,x,y){return set.has(key(x,y))}
function trailHas(p,x,y){return p.trail.some(c=>c.x===x&&c.y===y)}

function movePlayer(p){
 if(!p.alive)return;
 if(p.isHuman){
  direction=nextDirection;
  p.dir={...direction};
 }else botAI(p);

 const nx=p.x+p.dir.x,ny=p.y+p.dir.y;
 if(!isInside(nx,ny)){p.dir={x:-p.dir.x,y:-p.dir.y};return}
 p.x=nx;p.y=ny;p.steps++;

 const own=has(p.territory,nx,ny);
 if(p.trail.length){
  if(trailHas(p,nx,ny)){
   kill(p);return;
  }
  // A closed trail is captured when the player returns to their territory.
  if(own){
   capture(p);
   return;
  }
  p.trail.push({x:nx,y:ny});
  return;
 }
 if(!own){
  p.trail.push({x:nx,y:ny});
 }
}

function kill(p){
 p.alive=false;
 p.trail=[];
 if(p.isHuman)finish(false);
}

function capture(p){
 if(!p.trail.length)return;
 const blocked=new Set(p.territory);
 p.trail.forEach(c=>blocked.add(key(c.x,c.y)));

 // Find all unclaimed cells connected to the board boundary.
 const visited=new Uint8Array(W*H);
 const queue=new Int32Array(W*H);
 let head=0,tail=0;
 function enqueue(x,y){
  if(!isInside(x,y))return;
  const k=key(x,y);
  if(visited[k]||blocked.has(k))return;
  visited[k]=1;queue[tail++]=k;
 }
 for(let x=0;x<W;x++){enqueue(x,0);enqueue(x,H-1)}
 for(let y=0;y<H;y++){enqueue(0,y);enqueue(W-1,y)}
 while(head<tail){
  const k=queue[head++],x=k%W,y=Math.floor(k/W);
  enqueue(x+1,y);enqueue(x-1,y);enqueue(x,y+1);enqueue(x,y-1);
 }

 // Cells not reachable from the edge are enclosed by the trail and territory.
 for(let k=0;k<W*H;k++){
  if(!visited[k])p.territory.add(k);
 }
 p.trail.forEach(c=>p.territory.add(key(c.x,c.y)));
 p.trail=[];
 if(p.isHuman){
  updateHud();
  const pct=p.territory.size/(W*H)*100;
  if(pct>=levels[level].goal)finish(true);
 }
}

function botAI(p){
 if(p.trail.length){
  // Return to the nearest cell of the bot's own territory.
  let nearest=null,best=Infinity;
  for(const k of p.territory){
   const c=unpack(k),d=Math.abs(c.x-p.x)+Math.abs(c.y-p.y);
   if(d<best){best=d;nearest=c}
  }
  if(nearest){
   if(Math.random()<.65){
    if(Math.abs(nearest.x-p.x)>Math.abs(nearest.y-p.y))
     p.dir={x:Math.sign(nearest.x-p.x),y:0};
    else p.dir={x:0,y:Math.sign(nearest.y-p.y)};
   }
  }
 }else{
  p.botTurn--;
  if(p.botTurn<=0){
   p.botTurn=4+Math.floor(Math.random()*9);
   const options=[
    {x:1,y:0},{x:-1,y:0},{x:0,y:1},{x:0,y:-1}
   ].filter(d=>!(d.x===-p.dir.x&&d.y===-p.dir.y));
   // Prefer directions that lead away from borders.
   options.sort((a,b)=>{
    const score=d=>Math.min(p.x+d.x*5,W-1-(p.x+d.x*5),
                            p.y+d.y*5,H-1-(p.y+d.y*5));
    return score(b)-score(a);
   });
   p.dir=options[Math.floor(Math.random()*Math.min(2,options.length))]||p.dir;
  }
  const aheadX=p.x+p.dir.x*4,aheadY=p.y+p.dir.y*4;
  if(!isInside(aheadX,aheadY)){
   p.dir={x:-p.dir.x,y:-p.dir.y};
   p.botTurn=0;
  }
 }
}

function collisionCheck(){
 if(!game)return;
 const alive=game.players.filter(p=>p.alive);
 for(const p of alive){
  if(!p.trail.length)continue;
  for(const other of alive){
   if(other===p)continue;
   if(trailHas(other,p.x,p.y)){kill(p);break}
   if(other.trail.some(c=>c.x===p.x&&c.y===p.y)){
    kill(p);break;
   }
  }
 }
}

function tick(){
 if(!game||paused||game.ended)return;
 game.tick++;
 const alive=game.players.filter(p=>p.alive);
 alive.forEach(movePlayer);
 collisionCheck();
 // Bots may be eliminated by contact with their own or another player's trail.
 const human=game.players[0];
 if(human&&!human.alive)return;
 const remaining=game.players.filter(p=>!p.isHuman&&p.alive).length;
 if(remaining===0)finish(true);
 updateHud();
}

function finish(win){
 if(!game||game.ended)return;
 game.ended=true;
 paused=true;
 if(win){
  unlocked=Math.max(unlocked,Math.min(levels.length,level+2));
  $("endEmoji").textContent="🏆";
  $("endTitle").textContent="Level geschafft!";
  $("endText").textContent=`Du hast Level ${level+1} abgeschlossen.`;
  $("nextBtn").classList.toggle("hidden",level>=levels.length-1);
 }else{
  $("endEmoji").textContent="💔";
  $("endTitle").textContent="Game Over";
  $("endText").textContent="Deine Spur wurde getroffen. Versuche es erneut!";
  $("nextBtn").classList.add("hidden");
 }
 showPanel("endPanel");
}

function loop(now){
 if(!game||game.ended)return;
 if(!paused){
  const dt=Math.min(now-lastTime,100);
  accumulator+=dt;
  const speed=levels[level].speed;
  while(accumulator>=speed){
   tick();
   accumulator-=speed;
   if(!game||game.ended)break;
  }
  draw();
 }
 lastTime=now;
 if(game&&!game.ended)requestAnimationFrame(loop);
}

function draw(){
 if(!ctx)return;
 const r=$("boardWrap").getBoundingClientRect();
 const w=r.width,h=r.height;
 ctx.clearRect(0,0,w,h);
 ctx.fillStyle="#f1f0f8";ctx.fillRect(0,0,w,h);
 ctx.save();
 ctx.translate(offsetX,offsetY);

 // Soft board background and grid
 ctx.fillStyle="#fff";ctx.fillRect(0,0,W*cell,H*cell);
 ctx.strokeStyle="#f0edf5";ctx.lineWidth=.5;
 for(let x=0;x<=W;x++){
  ctx.beginPath();ctx.moveTo(x*cell,0);ctx.lineTo(x*cell,H*cell);ctx.stroke();
 }
 for(let y=0;y<=H;y++){
  ctx.beginPath();ctx.moveTo(0,y*cell);ctx.lineTo(W*cell,y*cell);ctx.stroke();
 }

 if(game){
  // Territory cells
  for(const p of game.players){
   for(const k of p.territory){
    const x=k%W,y=Math.floor(k/W);
    ctx.fillStyle=p.color;
    ctx.globalAlpha=.75;
    ctx.fillRect(x*cell+.4,y*cell+.4,cell-.8,cell-.8);
   }
  }
  ctx.globalAlpha=1;

  // Trails
  for(const p of game.players){
   if(!p.alive)continue;
   if(p.trail.length){
    ctx.beginPath();
    ctx.moveTo((p.trail[0].x+.5)*cell,(p.trail[0].y+.5)*cell);
    for(let i=1;i<p.trail.length;i++)
     ctx.lineTo((p.trail[i].x+.5)*cell,(p.trail[i].y+.5)*cell);
    ctx.strokeStyle=p.color;ctx.lineWidth=cell*.72;
    ctx.lineCap="round";ctx.lineJoin="round";ctx.stroke();
    p.trail.forEach(c=>{
     ctx.fillStyle=p.color;
     ctx.beginPath();ctx.arc((c.x+.5)*cell,(c.y+.5)*cell,cell*.32,0,Math.PI*2);ctx.fill();
    });
   }
  }

  // Player tokens
  for(const p of game.players){
   if(!p.alive)continue;
   const x=(p.x+.5)*cell,y=(p.y+.5)*cell;
   ctx.fillStyle="#ffffff";
   ctx.beginPath();ctx.arc(x,y,cell*.57,0,Math.PI*2);ctx.fill();
   ctx.font=`${Math.max(10,cell*.95)}px system-ui`;
   ctx.textAlign="center";ctx.textBaseline="middle";
   ctx.fillText(p.emoji,x,y+.3);
  }
 }
 ctx.restore();
}

makeEmojiGrid();
makeLevelGrid();
resize();
showPanel("startPanel");
})();
</script>
</body>
</html>
